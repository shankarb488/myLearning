package javademo;

public class MinimumNumberFromArray {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int[][] abc = { { 2, 4, 7 }, { 6, 3, 7 }, { 1, 9, 6 } };
		int min = abc[0][0];

		for (int i = 0; i < 3; i++) {
			for (int j = 0; j < 3; j++) {
				if (abc[i][j] < min) {
					System.out.println(abc[i][j]);
				}

			}
		}

	}

}
