package javademo;

import java.util.LinkedHashSet;
import java.util.Set;

public class PrintingUniqNumber {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		int[] a = {10,2,2,3,3,3,4,4,5,3,4,6,9,6};

        Set<Integer> set = new LinkedHashSet<>();
        for (int num : a) {
            set.add(num);
        }

        // Print unique numbers in original insertion order
        for (Integer num : set) {
            System.out.print(num + " ");
        }
        // Expected output: 2 3 4 5 6 9

	}

}
